# Base URL of the KS-Ops service (no trailing slash). Plans, company-code check, sign-up and status calls go here.
VITE_OPS_URL=https://ops.example.com
# Product name shown everywhere on the site. Change this one value when the name is final.
VITE_PRODUCT_NAME=Keystone
# Public sales / support inbox used for mailto links.
VITE_CONTACT_EMAIL=hello@example.com
# Optional: Cloudflare Turnstile site key. When set, sign-up shows the Turnstile check.
VITE_TURNSTILE_SITE_KEY=
# Optional: public site origin used in canonical links.
VITE_SITE_URL=
